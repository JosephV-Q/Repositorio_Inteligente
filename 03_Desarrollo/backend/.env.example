PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Credenciales de Administrador para arranque
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123456
ADMIN_ROLE=1

# Clave secreta para hashing HMAC de contraseñas y firma de tokens
HASH_SECRET=super_secret_hash_key_123456789_change_in_production

# ==============================================================================
# ALMACENAMIENTO GOOGLE DRIVE (Cuenta común)
# ==============================================================================
# Opción A (Recomendada): Cuenta de Servicio (Service Account de Google Cloud)
GOOGLE_DRIVE_CLIENT_EMAIL=cuenta-servicio@tu-proyecto.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# o alternativamente el contenido completo del JSON descargado de Google Cloud:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Opción B: OAuth2 con Refresh Token de una cuenta común
# GOOGLE_DRIVE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=tu_client_secret
# GOOGLE_DRIVE_REFRESH_TOKEN=tu_refresh_token

# ID de Carpeta compartida en Drive (Opcional, para agrupar los archivos subidos)
GOOGLE_DRIVE_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_id_carpeta_drive

# Origen web del Frontend (Opcional pero recomendado para subida directa desde el navegador)
# Permite a Google Drive configurar las cabeceras CORS ('Access-Control-Allow-Origin') en sesiones resumibles
FRONTEND_ORIGIN=https://test.utsvps.com

